# Supabase (Fase 1: reemplaza estos valores con los de tu proyecto en supabase.com)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Zona horaria de la aplicacion
NEXT_PUBLIC_APP_TZ=America/Costa_Rica

# Resend (Fase 8D: notificaciones por correo)
RESEND_API_KEY=
# Mientras no tengas un dominio verificado en Resend, deja el de pruebas:
RESEND_FROM_EMAIL=onboarding@resend.dev

# Google Calendar (Fase 8E)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Debe coincidir exacto con el "Authorized redirect URI" en Google Cloud Console
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integraciones/google/callback

# WhatsApp / Twilio (Fase 8F: aviso al paciente cuando se confirma una cita)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Formato E.164, SIN el prefijo "whatsapp:" (el código lo agrega solo).
# Mientras uses el Sandbox de Twilio, es el número de prueba que te da Twilio,
# ej. +14155238886 — no tu propio número.
TWILIO_WHATSAPP_NUMBER=
